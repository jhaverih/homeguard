{
  "expo": {
    "name": "Attenteve",
    "slug": "homeguard",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "homeguard",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B2529"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.homeguard.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Attenteve needs camera access to take inspection photos.",
        "NSPhotoLibraryUsageDescription": "Attenteve needs photo library access to upload inspection photos.",
        "NSLocationWhenInUseUsageDescription": "Attenteve uses your location to match you with nearby service requests and vendors.",
        "NSFaceIDUsageDescription": "Attenteve uses Face ID to let you sign in securely."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1B2529"
      },
      "package": "com.homeguard.app",
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "usesCleartextTraffic": true,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#F2A93C"
        }
      ],
      "./plugins/withAndroidCleartextTraffic",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "9ec8fbd8-d213-4bc8-9c9d-646646255a46"
      },
      "router": {}
    },
    "owner": "hjhaveri01"
  }
}
