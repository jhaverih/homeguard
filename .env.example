# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=homeguard
DB_USER=homeguard
DB_PASSWORD=changeme_strong_password_here

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme_strong_password_here

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=changeme_very_long_random_secret_here
JWT_EXPIRES_IN=7d

# ── MinIO (File Storage) ──────────────────────────────────────────────────────
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme_strong_password_here
MINIO_BUCKET_NAME=homeguard

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
PLATFORM_FEE_PERCENT=15

# ── Expo Push Notifications ───────────────────────────────────────────────────
EXPO_ACCESS_TOKEN=your_expo_access_token_here

# ── App Config ────────────────────────────────────────────────────────────────
NODE_ENV=staging
API_PORT=3000
ADMIN_PORT=3002
API_URL=http://localhost/api

# ── QNAP specific (set these on the QNAP at /share/Container/homeguard/.env) ──
# Copy this file to /share/Container/homeguard/.env on the QNAP and fill in real values

# ── Email (SMTP) ────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM_NAME=Houmi
