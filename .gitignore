# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
build/
.next/
out/
*.tsbuildinfo

# Environment — .env* catches every variant (.env, .env.local, .env.production,
# .env.staging, etc.) so a new env file is never accidentally trackable by
# default; the two lines below un-ignore the example files that ARE meant to
# be committed (placeholders only, no real values).
.env*
!.env.example
!apps/*/.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/settings.json
.idea/
*.swp

# Turbo
.turbo/

# Expo
.expo/
web-build/
android/
ios/

# Test coverage
coverage/
infrastructure/.env

# Firebase service account keys — sensitive, never commit (google-services.json
# itself is fine to commit, it's public identifiers only per Expo's own docs)
firebase-service-account*.json
apps/mobile/firebase-adminsdk*.json
