# License reader service (runs on the laptop next to Ollama).
# Copy to .env in this folder and fill in READER_TOKEN; .env is git-ignored.

# Shared password. Must match READER_TOKEN in the QNAP's .env (GitHub secret QNAP_READER_TOKEN).
READER_TOKEN=

# Where Ollama is listening on this laptop.
OLLAMA_URL=http://127.0.0.1:11434

# Model for PDFs that contain text (fast).
TEXT_MODEL=llama3.1:8b

# Model for photos and scanned PDFs (reads images; slower on a CPU).
VISION_MODEL=qwen2.5vl:7b

# Port the service listens on (the QNAP calls http://192.168.86.35:PORT).
PORT=8090
